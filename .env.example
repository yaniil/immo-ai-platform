# Copiez ce fichier en .env puis renseignez au moins une clé API.

# Groq (offre gratuite) : https://console.groq.com/keys
GROQ_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Fournisseur et modèle de l'agent (groq | anthropic | openai)
IMMO_LLM_PROVIDER=groq
IMMO_LLM_MODEL=openai/gpt-oss-120b
# Modèle juge pour `immo evaluate` (par défaut : le même)
# IMMO_JUDGE_MODEL=

# Recherche sémantique dans la documentation (télécharge un petit modèle d'embeddings au 1er lancement)
IMMO_RAG_DENSE=true
